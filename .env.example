# 딥택트러닝 앱 라이브러리 — 환경변수 템플릿
# 둘 다 선택사항이지만 둘 다 비우면 apps.json 정적 데이터만 표시된다.

# GitHub 사용자명 또는 조직명 (예: matt-park)
GITHUB_OWNER=

# GitHub Personal Access Token (public_repo 권한)
# 토큰 없이도 동작하지만 비인증 API는 시간당 60회 제한이므로 ISR 빌드에는 권장.
GITHUB_TOKEN=

# Morning Sender V4 — server only
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Windows Agent와 Vercel API 사이의 공유 비밀키. 충분히 긴 랜덤 문자열 사용.
MORNING_AGENT_KEY=
